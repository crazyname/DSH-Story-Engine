{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dsh-story-engine/pack-v1.schema.json",
  "title": "DSH Story Pack V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "language", "license", "player", "modules", "content"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlledCharacters", "aiMayControlPlayer"],
      "properties": {
        "controlledCharacters": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "aiMayControlPlayer": { "type": "boolean" }
      }
    },
    "modules": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialState"],
      "properties": {
        "world": { "type": "string" },
        "characters": { "type": "string" },
        "lore": { "type": "string" },
        "mechanics": { "type": "string" },
        "story": { "type": "string" },
        "initialState": { "type": "string", "minLength": 1 },
        "gameMasterPrompt": { "type": "string" }
      }
    }
  }
}
